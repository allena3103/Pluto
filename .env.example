# Pluto environment variables. Copy nothing by hand for local dev: run `npm run env:local`,
# which writes apps/web/.env.local from the local Supabase stack plus these defaults.
# Real keys go in C:/Pluto/.env.secrets (never committed) or the Vercel project settings.

# --- Supabase (filled by env:local from `npx supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Allowed only in: /api/ingest, /api/sms/inbound, /api/alerts/*, /api/canvas/* sync, /open/:token, MCP demo-token fallback.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL, used by `npm run seed` only.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ---
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for server-to-server routes (header `x-internal-secret`): /api/ingest, /api/alerts/*, /api/agent/reply.
INTERNAL_API_SECRET=dev-internal-secret-change-me

# --- Agent (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# `mock` = deterministic scripted tool calls, no key needed. `anthropic` = real API.
PLUTO_LLM=mock

# --- SMS ---
# `simulator` = messages stored in sms_messages and shown at /sms-sim. `sendblue` = real Sendblue sandbox.
SMS_PROVIDER=simulator
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=

# --- Canvas ---
# `fixtures` = recorded JSON in packages/canvas/fixtures. `live` = real Canvas API.
CANVAS_MODE=fixtures
CANVAS_BASE_URL=
# 32-byte key, base64. Encrypts Canvas tokens at rest (AES-256-GCM). Dev-only default below; set a real one for deploys.
CANVAS_TOKEN_KEY=ZGV2LW9ubHktY2FudmFzLXRva2VuLWtleS0zMmJ5dGU=

# --- MCP ---
# Fallback bearer token that maps to the demo student. Empty = fallback disabled.
PLUTO_DEMO_MCP_TOKEN=

# --- Seeded students (local dev passwords; `npm run seed` sets them) ---
DEMO_STUDENT_EMAIL=demo@pluto.test
DEMO_STUDENT_PASSWORD=pluto-demo-local-1
OTHER_STUDENT_EMAIL=other@pluto.test
OTHER_STUDENT_PASSWORD=pluto-other-local-1
